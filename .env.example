# Copia questo file in .env e compila i valori reali
# cp .env.example .env

# Porta del server (default: 3000)
PORT=3000

# Ambiente: development | production
NODE_ENV=development

# Stringa di connessione MongoDB
# Locale: mongodb://localhost:27017/ebook-creator
# Atlas: mongodb+srv://UTENTE:PASSWORD@cluster.mongodb.net/ebook-creator
MONGO_URI=mongodb://localhost:27017/ebook-creator

# Chiave segreta per la firma dei JWT (OBBLIGATORIA – usare una stringa casuale lunga)
JWT_SECRET=cambia_questa_stringa_con_un_valore_casuale_sicuro

# Credenziali MongoDB (usate da docker-compose)
MONGO_USER=ebook_user
MONGO_PASSWORD=cambia_questa_password
